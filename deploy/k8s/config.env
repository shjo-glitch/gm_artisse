# 비밀이 아닌 설정 (ConfigMap). 비밀 값은 secret.env 에 넣는다.

# 사용자가 접속하는 주소. MS 로그인 리디렉션, Secure 쿠키, 팀즈 카드 링크가 이 주소를 쓴다. ingress.yaml 의 host 와 맞춘다.
PUBLIC_URL=https://attije.example.internal

# 이름으로 처음 계정을 연결할 때 허용할 Entra 부서 (쉼표로 구분, 비우면 부서를 보지 않음)
TEAM_DEPARTMENTS=

# 외부(Microsoft 로그인·Graph, Power Automate, 아띠제 새메뉴 API)로 나갈 때 프록시가 필요하면 적는다.
# 이미지에 NODE_USE_ENV_PROXY=1 이 켜져 있어 Node fetch가 이 값을 따른다.
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=localhost,127.0.0.1,.svc,.cluster.local

# 새메뉴 자동 반영의 포스터 읽기를 사내 LLM(OpenAI 호환 API, 이미지를 읽는 모델)으로 할 때 적는다.
# Cloudflare Workers AI를 계속 쓰려면 비워 두고 secret.env 에 CF_ACCOUNT_ID, CF_API_TOKEN 을 넣는다.
AI_BASE_URL=
AI_MODEL=

# 매달 1일 09:00 자동 반영을 끄려면 0
SEASON_CRON=1
