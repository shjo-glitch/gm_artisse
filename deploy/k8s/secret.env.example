# cp secret.env.example secret.env 후 값을 채운다. secret.env 는 git에 올리지 않는다(.gitignore).

# 관리자 화면 아이디·비밀번호
ADMIN_ID=
ADMIN_PASSWORD=

# MS 로그인 (Entra 앱 등록 값). SESSION_SECRET 은 openssl rand -base64 32 같은 임의 값
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
SESSION_SECRET=

# 팀즈 알림 (Power Automate 워크플로 주소). 비우면 관리자 화면의 알림·독촉 버튼이 꺼진다.
TEAMS_CHANNEL_WEBHOOK_URL=
TEAMS_DM_WEBHOOK_URL=

# 새메뉴 자동 반영: Cloudflare Workers AI REST API를 쓸 때 (사내 LLM을 쓰면 config.env 의 AI_BASE_URL)
CF_ACCOUNT_ID=
CF_API_TOKEN=
# 사내 LLM에 키가 필요하면
AI_API_KEY=
